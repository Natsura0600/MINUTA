{
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/menu?pagina=tienda"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/menu?pagina=robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/menu?pagina=sitemap"
    },
    {
      "source": "/ayuda",
      "destination": "/ayuda.html"
    },
    {
      "source": "/salud",
      "destination": "/api/menu?pagina=salud"
    },
    {
      "source": "/estado",
      "destination": "/api/menu?pagina=estado"
    },
    {
      "source": "/inicio",
      "destination": "/inicio.html"
    },
    {
      "source": "/admin",
      "destination": "/app.html"
    },
    {
      "source": "/superadmin",
      "destination": "/superadmin.html"
    },
    {
      "source": "/terminos",
      "destination": "/legal.html"
    },
    {
      "source": "/privacidad",
      "destination": "/legal.html"
    },
    {
      "source": "/arrepentimiento",
      "destination": "/legal.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/(admin|superadmin|app.html|superadmin.html|ayuda.html|ayuda)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/brand/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "functions": {
    "api/menu.js": {
      "includeFiles": "public/app.html"
    }
  }
}
